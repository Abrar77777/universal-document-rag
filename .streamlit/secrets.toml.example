# Copy these values into Streamlit Cloud -> App -> Settings -> Secrets.
# Do not commit a real .streamlit/secrets.toml file with actual keys.

GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.5-flash-lite"
RAG_ALLOW_GROQ_FALLBACK = false

# Use an AI Studio Free tier project with no paid API billing.
# A model with a free tier can still incur charges on a billing-enabled project.

# Optional only after independently reviewing Groq account billing/limits.
# RAG_ALLOW_GROQ_FALLBACK = true
# GROQ_API_KEY = "your_groq_api_key_here"
# GROQ_MODEL = "llama-3.1-8b-instant"
